<?php
// Simulación de base de datos con SQLite para SQL Injection
try {
    $db = new PDO('sqlite::memory:');
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    $db->exec("CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT, password TEXT, email TEXT)");
    $db->exec("INSERT INTO users (username, password, email) VALUES ('admin', 'admin123', 'admin@vunlabs.local')");
    $db->exec("INSERT INTO users (username, password, email) VALUES ('juan', 'secret1', 'juan@vunlabs.local')");
    $db->exec("INSERT INTO users (username, password, email) VALUES ('laura', 'qwerty', 'laura@vunlabs.local')");

    $resultado = [];
    $error = "";

    if (isset($_GET['search'])) {
        $search = $_GET['search'];

        // ⚠️ VULNERABILIDAD CRÍTICA: Concatenación directa del input
        $query = "SELECT username, email FROM users WHERE username = '$search'";
        
        $stmt = $db->query($query);
        $resultado = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
} catch (Exception $e) {
    $error = "Error: " . $e->getMessage();
}
